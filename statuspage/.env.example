# ── Boltarr status page config ────────────────────────────────────────────────
# Copy this file to .env and set long, random secrets.

# Shared push token. The SAME value must be entered in Boltarr under
# Settings → Public status page → Token.
STATUS_TOKEN=change-me-to-a-long-random-secret

# Admin password. Log in on the status page with this to unlock Private sections
# (hosts, networking) and the visibility controls. Leave BLANK to disable admin
# login entirely (the page then serves public sections only — fail closed).
STATUS_ADMIN_PASSWORD=

# Signing secret for the login session cookie. Optional — if left blank, a random
# secret is generated and stored in the database (so sessions survive restarts).
# Set it explicitly to keep sessions valid across a full data wipe / multi-host.
STATUS_SESSION_SECRET=

# Secure cookies require HTTPS. Keep TRUE for internet exposure. Set to false ONLY
# for local http testing, otherwise you will not stay logged in.
STATUS_COOKIE_SECURE=true

# Set true ONLY if you run behind a reverse proxy you control that sets a correct
# X-Forwarded-For. When true, the login rate limiter uses the client IP from that
# header. Leave false if unsure (an untrusted XFF lets attackers dodge the limit).
TRUST_PROXY=false
